# Vercel deployment ignore
# This file overrides .gitignore for Vercel deploys.
# /public/photos/ is intentionally NOT listed here
# so photos deploy to Vercel but never go to GitHub.

node_modules/
.next/
/coverage
/out
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
.pnpm-debug.log*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.tsbuildinfo
.bun/
