# Non-secret runtime label: local, preview, staging, or production.
# Vercel derives this automatically; set it explicitly for local staging builds.
NEXT_PUBLIC_DEPLOYMENT_ENV=local

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin access
# Comma-separated allowlist. Leave blank only if you intentionally want any signed-in user to access admin.
ADMIN_EMAILS=

# Resend / email sending
RESEND_API_KEY=
BOOKING_FROM_EMAIL=
# Production defaults to live delivery. Preview/staging/local default to disabled.
# Use redirect in staging so every message goes to EMAIL_REDIRECT_TO instead of a client.
EMAIL_DELIVERY_MODE=
EMAIL_REDIRECT_TO=

# Stripe / deposit payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=

# Booking alerts
# Optional. Defaults are used in code if omitted, but setting these explicitly is safer.
BOOKING_ALERT_EMAIL=
BOOKING_ALERT_PHONE=
BOOKING_ZELLE_HANDLE=
BOOKING_CASH_APP_HANDLE=

# Twilio SMS alerts
# Optional unless you want booking SMS notifications enabled.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Upstash Redis rate limiting
# Optional. If omitted, public rate limits are disabled but the site still builds and runs.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel cron authentication
CRON_SECRET=
